# ShopIntel backend — development env template.
# Copy to `.env.development` (which is gitignored) and fill in real values.
# Keys below match app/config/settings.py exactly. Do NOT commit real secrets.

# --- Application (required, no defaults in settings) ---
APP_NAME=ShopIntel
APP_VERSION=0.1.0
DEBUG=true

# --- Database (required) ---
# SQLAlchemy + psycopg driver, PostgreSQL.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/shopintel

# --- Security (required) ---
SECRET_KEY=replace-me-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Logging (optional; defaults shown) ---
# LOG_LEVEL=INFO
# LOG_FORMAT=text
# LOG_FILE=logs/shopintel.log

# --- CORS (optional; defaults shown) ---
# BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# BACKEND_CORS_CREDENTIALS=true
# BACKEND_CORS_METHODS=*
# BACKEND_CORS_HEADERS=*
